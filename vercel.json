{
  "version": 2,
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.7.4", "config": { "maxLambdaSize": "50mb", "maxDuration": 60 } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "public/build/$1" },
    { "src": "/images/(.*)", "dest": "public/images/$1" },
    { "src": "/fonts/(.*)", "dest": "public/fonts/$1" },
    { "src": "/favicon.png", "dest": "public/favicon.png" },
    { "src": "/favicon.ico", "dest": "public/favicon.ico" },
    { "src": "/site.webmanifest", "dest": "public/site.webmanifest" },
    { "src": "/robots.txt", "dest": "public/robots.txt" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp",
    "CACHE_STORE": "array",
    "CACHE_DRIVER": "array",
    "SESSION_DRIVER": "cookie",
    "QUEUE_CONNECTION": "sync",
    "LOG_CHANNEL": "stderr",
    "DB_CONNECTION": "pgsql"
  }
}
